From 8735724d1d2a3786b47cee4bcce3663b75d8b2cb Mon Sep 17 00:00:00 2001
From: "T. Kurt Bond" <tkurtbond@gmail.com>
Date: Sat, 3 Oct 2026 13:42:54 -0400
Subject: [PATCH 32/48] Out.Real and LongReal: correctly rounded digits, from
 C's printf

Needs "Out.LongReal writes a subnormal number, not 0" and "Out.Real and
LongReal: write the exponent after rounding the digits" first: it
replaces the lines they change.

RealP scaled x by powers of ten made by repeated squaring (Ten) and
rounded the scaled value, each step rounding, so the digits were often
not those of x: of 2000 random doubles written with 17 significant
digits (LongReal(x, 24)), 1677 did not read back as the same double,
though 17 digits always suffice. The digits and the exponent now come
from snprintf's "%.*e", which rounds correctly; the formatting around
them (width, trailing zeroes, the exponent's form) is as before.

The confidence test out's expected digits change to the ones the doubles
really have: 1.1D0 is 1.10000000000000008882, so 17 digits are
1.1000000000000001, and 1.2345678987654321D3 is written
1.2345678987654321D+003, not 1.2345678987654320D+003. The confidence
test math's change the same way: they are now the digits of the values
MathL returns (MathL.sqrt(2.0D0) is 1.4142135623730949, an ulp below the
correctly rounded square root, so 15 digits are 1.41421356237309, and
MathL.tanh(0.9) ends in 024, not 025).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/Out.Mod               | 43 ++++++++++++-------------------
 src/test/confidence/math/expected | 16 ++++++------
 src/test/confidence/out/expected  | 24 ++++++++---------
 3 files changed, 37 insertions(+), 46 deletions(-)

diff --git a/src/runtime/Out.Mod b/src/runtime/Out.Mod
index 54da3052..c74c47f5 100644
--- a/src/runtime/Out.Mod
+++ b/src/runtime/Out.Mod
@@ -121,7 +121,11 @@
   RETURN r
 END Ten;
 
-PROCEDURE -Entier64(x: LONGREAL): SYSTEM.INT64 "(INT64)(x)";
+PROCEDURE -AAincludeStdio '#include <stdio.h>';
+
+(* x as C's "%.*e" with digits after the point: d.ddde+xx, correctly rounded. *)
+PROCEDURE -FormatE(VAR s: ARRAY OF CHAR; digits: INTEGER; x: LONGREAL)
+  'snprintf((char*)s, (size_t)s__len, "%.*e", (int)digits, x)';
 
 (** RealP(x, n) writes the long real number x to the end of the output stream using an
    exponential form. If the textual representation of x requires m characters (including  a
@@ -138,13 +142,13 @@
   s:   ARRAY 30 OF CHAR; (* Buffer built backwards *)
   i:   INTEGER;          (* Index into s *)
   el:  INTEGER;          (* Exponent length *)
-  x0:  LONGREAL;
   nn:  BOOLEAN;          (* Number negative *)
   en:  BOOLEAN;          (* Exponent negative *)
   m:   HUGEINT;          (* Mantissa digits *)
   d:   INTEGER;          (* Significant digit count to display *)
   dr:  INTEGER;          (* Number of insignificant digits that can be dropped *)
-  shift: INTEGER;        (* Decimal places a subnormal x was scaled up by *)
+  text: ARRAY 32 OF CHAR; (* d digits and the exponent from printf *)
+  k:   INTEGER;          (* Index into text *)
 
 BEGIN
   e  := SYSTEM.VAL(INTEGER, (SYSTEM.VAL(HUGEINT, x) DIV 10000000000000H) MOD 800H);
@@ -179,31 +183,18 @@
     ELSE
       IF nn THEN x := -x END;
 
-      (* A subnormal x (e = 0) is scaled into the normal range first: below,
-         Ten(-e) would overflow. *)
-      shift := 0;
-      IF e = 0 THEN
-        x := x * Ten(20); shift := 20;
-        e := SYSTEM.VAL(INTEGER, (SYSTEM.VAL(HUGEINT, x) DIV 10000000000000H) MOD 800H)
+      (* d significant digits of x, correctly rounded, by C's printf *)
+      FormatE(text, d-1, x);
+      m := 0; k := 0;
+      WHILE text[k] # "e" DO
+        IF text[k] # "." THEN m := m * 10 + (ORD(text[k]) - ORD("0")) END;
+        INC(k)
       END;
+      INC(k); en := text[k] = "-"; INC(k); e := 0;
+      WHILE text[k] # 0X DO e := e * 10 + (ORD(text[k]) - ORD("0")); INC(k) END;
+      IF en THEN e := -e END;
 
-      (* Scale e to be an exponent of 10 rather than 2 *)
-      e := SHORT(LONG(e - 1023) * 77 DIV 256);
-      IF e >= 0 THEN x := x / Ten(e) ELSE x := Ten(-e) * x END ;
-      IF x >= 10.0D0 THEN x := 0.1D0 * x; INC(e) END;
-      DEC(e, shift);
-
-      (* Scale x to enough significant digits to reliably test for trailing
-         zeroes or to the amount of space available, if greater. *)
-      x0 := Ten(d-1);
-      x  := x0 * x;
-      x  := x + 0.5D0; (* Do not combine with previous line as doing so
-                          introduces a least significant bit difference
-                          between 32 bit and 64 bit builds. *)
-      IF x >= 10.0D0 * x0 THEN x := 0.1D0 * x; INC(e) END;
-      m := Entier64(x);
-
-      (* Generate the exponent digits, after rounding, which may carry into e *)
+      (* Generate the exponent digits *)
       en := e < 0; IF en THEN e := - e END;
       WHILE el > 0 DO digit(e, s, i); e := e DIV 10; DEC(el) END;
       DEC(i); IF en THEN s[i] := "-" ELSE s[i] := "+" END
