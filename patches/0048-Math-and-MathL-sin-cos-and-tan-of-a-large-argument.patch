     r1 = -0.16666666666666665052D+0;
@@ -382,15 +384,97 @@
 
 (* The angle in all trigonometric functions is measured in radians *)
 
+PROCEDURE^ sin*(x: LONGREAL): LONGREAL;
+PROCEDURE^ cos*(x: LONGREAL): LONGREAL;
+
+(* Argument reduction for large arguments, after Payne and Hanek (and
+   fdlibm's __kernel_rem_pio2): y * 2/pi computed exactly enough from the
+   bits of 2/pi, 24 to an element of twoOverPi, the first bits after the
+   binary point first. Only the bits from y's exponent on matter, those
+   before contributing multiples of 4. *)
+PROCEDURE ReduceLarge(y: LONGREAL; VAR q: INTEGER; VAR r: LONGREAL);
+  (* y > 0 and finite: y = (4k + q + f) * pi/2 for an integer k,
+     0 <= q < 4 and -1/2 <= f < 1/2, and r := f * pi/2 *)
+  CONST two24 = 16777216; two52 = 4503599627370496;
+  VAR bits, m, e, carry, a, b, c: SYSTEM.INT64; j0, s, i, j: INTEGER;
+    mc: ARRAY 3 OF SYSTEM.INT64; p: ARRAY 11 OF SYSTEM.INT64; f, inv24: LONGREAL;
+    negative: BOOLEAN;
+
+  PROCEDURE Bits(lo, n: INTEGER): SYSTEM.INT64;
+    (* the n bits of P from bit lo up, as an integer; bits below 0 are 0 *)
+    VAR k: INTEGER; v: SYSTEM.INT64;
+  BEGIN v := 0;
+    FOR k := lo + n - 1 TO lo BY -1 DO
+      v := v * 2;
+      IF (k >= 0) & (k < 24 * LEN(p)) THEN INC(v, ASH(p[k DIV 24], -(k MOD 24)) MOD 2) END
+    END;
+    RETURN v
+  END Bits;
+
+BEGIN
+  bits := SYSTEM.VAL(SYSTEM.INT64, y);
+  e := bits DIV two52 MOD 2048; m := bits MOD two52;
+  IF e = 0 THEN e := 1 ELSE m := m + two52 END;
+  e := e - 1075;                                (* y = m * 2^e *)
+  (* the element holding bit e-1 of 2/pi, the first that matters, and the
+     seven after it: P := m * those 192 bits *)
+  IF e > 2 THEN j0 := SHORT(SHORT((e - 2) DIV 24)) ELSE j0 := 0 END;
+  mc[0] := m MOD two24; mc[1] := m DIV two24 MOD two24; mc[2] := m DIV two24 DIV two24;
+  FOR i := 0 TO LEN(p) - 1 DO p[i] := 0 END;
+  FOR i := 0 TO 7 DO
+    FOR j := 0 TO 2 DO p[7 - i + j] := p[7 - i + j] + twoOverPi[j0 + i] * mc[j] END
+  END;
+  carry := 0;
+  FOR i := 0 TO LEN(p) - 1 DO
+    p[i] := p[i] + carry; carry := p[i] DIV two24; p[i] := p[i] MOD two24
+  END;
+  (* y * 2/pi = P * 2^-s, modulo 4 *)
+  s := 24 * (j0 + 8) - SHORT(SHORT(e));
+  q := SHORT(SHORT(Bits(s, 2)));
+  (* the fraction, 144 bits of it: a, b, c, 48 each *)
+  a := Bits(s - 48, 48); b := Bits(s - 96, 48); c := Bits(s - 144, 48);
+  IF a >= two24 * two24 DIV 2 THEN
+    (* f >= 1/2: f - 1 = -(1 - f), the complement taken in the bits, since
+       subtracting in LONGREAL would cancel the leading bits *)
+    a := two24 * two24 - 1 - a; b := two24 * two24 - 1 - b; c := two24 * two24 - c;
+    q := (q + 1) MOD 4; negative := TRUE
+  ELSE negative := FALSE
+  END;
+  inv24 := ONE / 16777216.0D0;                  (* 2^-24, exactly *)
+  f := ((c * (inv24 * inv24) + b) * (inv24 * inv24) + a) * (inv24 * inv24);
+  IF negative THEN f := -f END;
+  r := f * piByTwo
+END ReduceLarge;
+
+PROCEDURE LargeSinCos(x: LONGREAL; cosine: BOOLEAN): LONGREAL;
+  (* sin(x), or cos(x), for |x| >= trigLarge *)
+  VAR q: INTEGER; r, y, res: LONGREAL;
+BEGIN
+  y := ABS(x);
+  IF y - y # ZERO THEN Math.ErrorHandler(Math.LossOfAccuracy); RETURN ZERO END;  (* infinity, NaN *)
+  ReduceLarge(y, q, r);
+  IF cosine THEN q := (q + 1) MOD 4 END;     (* cos(y) = sin(y + pi/2) *)
+  CASE q OF
+    0: res := sin(r)
+  | 1: res := cos(r)
+  | 2: res := -sin(r)
+  | 3: res := -cos(r)
+  END;
+  IF ~cosine & (x < ZERO) THEN res := -res END;
+  RETURN res
+END LargeSinCos;
+
 PROCEDURE sin* (x: LONGREAL): LONGREAL;
 BEGIN
-  IF x < ZERO THEN RETURN SinCos(x, -x, -ONE)
+  IF ABS(x) >= trigLarge THEN RETURN LargeSinCos(x, FALSE)
+  ELSIF x < ZERO THEN RETURN SinCos(x, -x, -ONE)
   ELSE RETURN SinCos(x, x, ONE)
   END
 END sin;
 
 PROCEDURE cos* (x: LONGREAL): LONGREAL;
 BEGIN
+  IF ABS(x) >= trigLarge THEN RETURN LargeSinCos(x, TRUE) END;
   RETURN SinCos(x, ABS(x) + piByTwo, ONE)
 END cos;
 
