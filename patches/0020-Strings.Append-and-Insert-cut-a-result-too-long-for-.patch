From 7c3c6e01100fd9bd7cbbc8bf26eabe6813752910 Mon Sep 17 00:00:00 2001
From: "T. Kurt Bond" <tkurtbond@gmail.com>
Date: Sat, 3 Oct 2026 13:29:54 -0400
Subject: [PATCH 20/48] Strings.Append and Insert cut a result too long for
 dest to end it with 0X

Oakwood: "If the size of dst is not large enough to hold the result of
the operation, the result is truncated so that dst is always terminated
with a 0X." Append filled dest to its last element and left no 0X, and
Insert, when the result did not fit, left none either and wrote the
inserted characters with no bound (an index trap, or a write past dest
without -x).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/Strings.Mod | 22 ++++++++++++----------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/src/runtime/Strings.Mod b/src/runtime/Strings.Mod
index 4a96cceb..7ae16099 100644
--- a/src/runtime/Strings.Mod
+++ b/src/runtime/Strings.Mod
@@ -43,25 +43,27 @@
   VAR n1, n2, i: INTEGER;
 BEGIN
   n1 := Length(dest); n2 := Length(extra); i := 0;
-  WHILE (i < n2) & (i + n1 < LEN(dest)) DO dest[i + n1] := extra[i]; INC(i) END ;
-  IF i + n1 < LEN(dest) THEN dest[i + n1] := 0X END
+  (* the result is cut short to leave room for the 0X (Oakwood) *)
+  WHILE (i < n2) & (i + n1 < LEN(dest) - 1) DO dest[i + n1] := extra[i]; INC(i) END ;
+  IF i + n1 < LEN(dest) THEN dest[i + n1] := 0X ELSE dest[LEN(dest) - 1] := 0X END
 END Append;
 
 
 PROCEDURE Insert* (source: ARRAY OF CHAR; pos: INTEGER; VAR dest: ARRAY OF CHAR);
-  VAR n1, n2, i: INTEGER;
+  VAR n1, n2, i, max: INTEGER;
 BEGIN
   n1 := Length(dest); n2 := Length(source);
   IF pos < 0 THEN pos := 0 END ;
   IF pos > n1 THEN Append(source, dest); RETURN END ;
-  IF pos + n2 < LEN(dest) THEN  (*make room for source*)
-    i := n1; (*move also 0X if it is there*)
-    WHILE i >= pos DO
-      IF i + n2 < LEN(dest) THEN dest[i + n2] := dest[i] END ;
-      DEC(i)
-    END
+  (* the result is cut short to leave room for the 0X (Oakwood) *)
+  max := SHORT(LEN(dest)) - 1;
+  i := n1 - 1;  (* make room for source *)
+  WHILE i >= pos DO
+    IF i + n2 < max THEN dest[i + n2] := dest[i] END ;
+    DEC(i)
   END ;
-  i := 0; WHILE i < n2 DO dest[pos + i] := source[i]; INC(i) END
+  i := 0; WHILE (i < n2) & (pos + i < max) DO dest[pos + i] := source[i]; INC(i) END ;
+  IF n1 + n2 < max THEN dest[n1 + n2] := 0X ELSE dest[max] := 0X END
 END Insert;
 
 
