From 90b0845a76b2adabc712055623c5ba513b771247 Mon Sep 17 00:00:00 2001
From: "T. Kurt Bond" <tkurtbond@gmail.com>
Date: Sat, 3 Oct 2026 13:13:29 -0400
Subject: [PATCH 05/48] Make MAX(REAL) and MAX(LONGREAL) the largest REAL and
 LONGREAL

Needs "Write real constants to C exactly" first: the exact
MAX(LONGREAL) written with 15 digits, 1.79769313486232e+308, is above
it, and C rounds it to infinity (which is why the old value was cut
short).

OPM.MaxLReal was 1.7976931348623157D307 * 9.999999, 7FEFFFFFCCCCCCD3,
about 1.7976929634D308, so MAX(LONGREAL) and MathL.large were below the
largest LONGREAL. OPM.MaxReal was 3.40282346D38, which is below the
largest REAL (3.4028234663852886D38) when folded: a folded MAX(REAL) was
not equal to one stored in a REAL. Both are now set from their IEEE 754
bit patterns. The math confidence test's expected output changes with
MathL.large.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/compiler/OPM.Mod              |  8 ++-
 src/test/confidence/math/expected | 98 +++++++++++++++----------------
 2 files changed, 55 insertions(+), 51 deletions(-)

diff --git a/src/compiler/OPM.Mod b/src/compiler/OPM.Mod
index 5d00c3cb..0e321625 100755
--- a/src/compiler/OPM.Mod
+++ b/src/compiler/OPM.Mod
@@ -99,6 +99,7 @@
     MaxIndex*: SYSTEM.INT64;
 
     MinReal*, MaxReal*, MinLReal*, MaxLReal*: LONGREAL;
+    MaxRealBits: SYSTEM.INT32; maxReal: REAL; MaxLRealBits: SYSTEM.INT64;
 
     noerr*:           BOOLEAN;
     curpos*, errpos*: LONGINT;  (* character and error position in source file *)
@@ -929,8 +930,11 @@
 
 
 BEGIN
-  MaxReal := 3.40282346D38;                      (* REAL is 4 bytes *)
-  MaxLReal := 1.7976931348623157D307 * 9.999999; (* LONGREAL is 8 bytes, should be 1.7976931348623157D308 *)
+  (* The largest finite REAL and LONGREAL, from their IEEE 754 bit patterns. *)
+  MaxRealBits := 7F7FFFFFH; SYSTEM.GET(SYSTEM.ADR(MaxRealBits), maxReal);
+  MaxReal := maxReal;                            (* REAL is 4 bytes: 3.40282347E38 *)
+  MaxLRealBits := 7FEFFFFFFFFFFFFFH;
+  SYSTEM.GET(SYSTEM.ADR(MaxLRealBits), MaxLReal); (* LONGREAL is 8 bytes: 1.7976931348623157D308 *)
   MinReal  := -MaxReal;
   MinLReal := -MaxLReal;
   FindInstallDir;
